#include <stdio.h>

#define FILENAME "output_data.txt"

int main() {

    FILE *fptr ;
    int year = 2025 ;

    fptr = fopen( FILENAME, "w" ) ;

    if( fptr == NULL ) {
        printf( "ERROR: Could not open file %s for writing.\n", FILENAME ) ;
    }// end if

    fprintf( fptr,"%s\n%d", "Hello, C File Handling is easy.", year ) ;
    fclose( fptr ) ;

    printf( "--- FILE WRITING PROCESS ---\n" ) ;
    printf( "Writing data to %s...\n", FILENAME ) ;

    printf( "File Writing Complete.\n" ) ;
    printf( "\n--- FILE OPERATION REPORT ---\n" ) ;
    printf( "Action: File created data written successfully.\n" ) ;
    printf( "Filename: %s\n", FILENAME ) ;

    return 0 ;
}// end function
