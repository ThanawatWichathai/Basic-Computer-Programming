#include <stdio.h>

struct empolyee{
    int id ;
    int G_salary ;
    int bonus ;
    int Total_income ;
} ;

int Cal_Net_salary( int Total_income ) ;

int main () {

    struct empolyee emp ;
    int N_salary = 0 ;

    printf( "Enter Id: " ) ;
    scanf( "%d" , &emp.id ) ;

    printf( "Enter gross Salary: " ) ;
    scanf( "%d" , &emp.G_salary ) ;

    printf( "Enter Bonus " ) ;
    scanf( "%d" , &emp.bonus ) ;

    emp.Total_income = emp.G_salary + emp.bonus ;
    N_salary = Cal_Net_salary( emp.Total_income ) ;

    printf( "\n---EMPLOYEE SALARY REPORT---\n" ) ;
    printf( "ID: %d\n" , emp.id ) ;
    printf( "Gross Salary: %d\n" , emp.G_salary ) ;
    printf( "Bonus: %d\n" , emp.bonus ) ;
    printf( "Total Income: %d\n" , emp.Total_income ) ;
    printf( "Net Salary: %d" , N_salary ) ;

    return 0 ;
}//end function

int Cal_Net_salary( int Total_income ) {
    int tax = 0 ;
    int N_S = 0 ;

    if( Total_income > 30000 ){
        tax = Total_income * 0.1 ;
    }else if( Total_income <= 30000 ) {
        tax = Total_income * 0.05 ;
    }//end if

    N_S = Total_income - tax ;

    return N_S ;
}//end function
