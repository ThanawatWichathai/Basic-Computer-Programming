#include <stdio.h>

int main() {
    int N , A ;

    if( scanf( "%d" , &N ) != 1 ) {
        return 1 ;
    }//end if 

    int stuscores[N] ;

    for( A = 0 ; A < N ; A ++ ) {
        if( scanf( "%d" , &stuscores[A] ) != 1 ) {
            return 1 ;
        }//end if
    }//end for

    for( A = N -1 ; A >= 0 ; A -- ) {
        printf( "%d\n" , stuscores[A] ) ;
    }//end for

    return 0 ;
}//end function
